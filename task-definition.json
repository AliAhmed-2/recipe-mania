{
  "family": "recipe-mania-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "recipe-mania",
      "image": "637423539253.dkr.ecr.eu-north-1.amazonaws.com/recipe-mania:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5173,
          "hostPort": 5173,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::637423539253:role/ecsTaskExecutionRole"
}
